+/**
+ * Grok Build Output Parser
+ *
+ * Parses --output-format streaming-json output from xAI's Grok Build CLI.
+ * Grok Build outputs JSONL (newline-delimited JSON) with streaming events.
+ *
+ * ⚠️  SCHEMA STATUS: Based on documented Grok Build behavior (May 2026 beta).
+ *    Event type names must be verified with a real `grok -p "..." --output-format streaming-json` run.
+ *    Grep TODOs in this file to find fields that need confirmation.
+ *
+ * To verify event types, run:
+ *   grok -p "say hello" --output-format streaming-json 2>&1 | head -50
+ *   grok --help | grep -i "resume\|session\|continue"
+ *
+ * Known Grok Build streaming-json contract (from xAI docs):
+ *   - Structured events: files modified, commands run, final results
+ *   - Session ID for resume support
+ *   - Token usage statistics (input/output/reasoning)
+ *   - JSONL format (one event per line)
+ *
+ * @see https://x.ai/news/grok-build-cli
+ */
+
+import type { ToolType, AgentError } from '../../shared/types';
+import type { AgentOutputParser, ParsedEvent } from './agent-output-parser';
+import { getErrorPatterns, matchErrorPattern } from './error-patterns';
+
+// ---------------------------------------------------------------------------
+// TODO: Verify these event type constants against real Grok Build output.
+// Run: grok -p "say hello" --output-format streaming-json 2>&1
+// If Grok uses a different event name, update only the constant here.
+// ---------------------------------------------------------------------------
+
+/** Init / session-start event — emitted once at the start of a turn. */
+const EV_INIT = 'session_start'; // TODO: verify — may be 'init', 'start', 'message_start'
+
+/** Streaming text delta event. */
+const EV_TEXT_DELTA = 'content_delta'; // TODO: verify — may be 'text', 'assistant', 'text_delta'
+
+/** Tool/command execution event. */
+const EV_TOOL_USE = 'tool_use'; // TODO: verify — may be 'tool_call', 'command', 'action'
+
+/** Tool execution result event. */
+const EV_TOOL_RESULT = 'tool_result'; // TODO: verify — may be 'tool_output', 'command_result'
+
+/** Reasoning / thinking delta (Grok 4 Heavy extended thinking). */
+const EV_THINKING = 'thinking_delta'; // TODO: verify — may be 'reasoning', 'thinking'
+
+/** Final result event — emitted at the end of a turn with usage stats. */
+const EV_RESULT = 'turn_complete'; // TODO: verify — may be 'result', 'done', 'message_stop', 'finish'
+
+/** Usage-only event (may be embedded in EV_RESULT instead of separate). */
+const EV_USAGE = 'usage'; // TODO: verify — may not exist as separate event
+
+// ---------------------------------------------------------------------------
+// Raw shape interfaces (best-effort based on xAI documentation)
+// ---------------------------------------------------------------------------
+
+interface GrokInitEvent {
+	type: typeof EV_INIT;
+	session_id?: string; // TODO: verify field name — may be 'sessionId', 'id', 'conversation_id'
+	model?: string;
+}
+
+interface GrokTextDeltaEvent {
+	type: typeof EV_TEXT_DELTA;
+	session_id?: string;
+	delta?: string; // TODO: verify — may be nested as {content: '...'} or {text: '...'}
+	content?: string;
+	text?: string;
+	is_partial?: boolean;
+}
+
+interface GrokThinkingEvent {
+	type: typeof EV_THINKING;
+	session_id?: string;
+	delta?: string;
+	thinking?: string;
+	text?: string;
+}
+
+interface GrokToolUseEvent {
+	type: typeof EV_TOOL_USE;
+	session_id?: string;
+	tool?: string; // TODO: verify — may be 'name', 'tool_name', 'command'
+	name?: string;
+	id?: string;
+	input?: unknown;
+	state?: string; // 'running' | 'complete' | 'error'
+}
+
+interface GrokResultEvent {
+	type: typeof EV_RESULT;
+	session_id?: string;
+	result?: string;
+	text?: string;
+	usage?: GrokUsage;
+	// Usage may be at the top level
+	input_tokens?: number;
+	output_tokens?: number;
+	reasoning_tokens?: number;
+	total_cost?: number; // TODO: verify field name
+	cost_usd?: number;
+}
+
+interface GrokUsage {
+	input_tokens?: number;
+	output_tokens?: number;
+	reasoning_tokens?: number; // Grok 4 Heavy extended thinking
+	total_cost?: number;
+	cost_usd?: number;
+}
+
+// ---------------------------------------------------------------------------
+// Parser
+// ---------------------------------------------------------------------------
+
+export class GrokBuildOutputParser implements AgentOutputParser {
+	readonly agentId: ToolType = 'grok-build';
+
+	parseJsonLine(line: string): ParsedEvent | null {
+		if (!line.trim()) {
+			return null;
+		}
+
+		try {
+			const event = JSON.parse(line) as Record<string, unknown>;
+			return this.parseEvent(event);
+		} catch {
+			// Non-JSON line — surface as raw text (e.g. startup messages, warnings)
+			return {
+				type: 'text',
+				text: line,
+				raw: line,
+			};
+		}
+	}
+
+	private parseEvent(event: Record<string, unknown>): ParsedEvent | null {
+		const type = event.type as string | undefined;
+
+		if (!type) {
+			return null;
+		}
+
+		// ---- Init / session start ----
+		if (type === EV_INIT) {
+			const e = event as unknown as GrokInitEvent;
+			return {
+				type: 'init',
+				sessionId: e.session_id,
+				raw: event,
+			};
+		}
+
+		// ---- Streaming text delta ----
+		if (type === EV_TEXT_DELTA) {
+			const e = event as unknown as GrokTextDeltaEvent;
+			// Grok may nest the text in delta, content, or text field
+			const text = e.delta ?? e.content ?? e.text ?? '';
+			if (!text) return null;
+			return {
+				type: 'text',
+				sessionId: e.session_id,
+				text,
+				isPartial: e.is_partial !== false, // default to partial for streaming deltas
+				raw: event,
+			};
+		}
+
+		// ---- Extended thinking / reasoning (Grok 4 Heavy) ----
+		if (type === EV_THINKING) {
+			const e = event as unknown as GrokThinkingEvent;
+			const text = e.delta ?? e.thinking ?? e.text ?? '';
+			if (!text) return null;
+			return {
+				type: 'text',
+				sessionId: e.session_id,
+				text,
+				isPartial: true,
+				raw: event,
+			};
+		}
+
+		// ---- Tool use ----
+		if (type === EV_TOOL_USE) {
+			const e = event as unknown as GrokToolUseEvent;
+			const toolName = e.tool ?? e.name ?? 'unknown_tool';
+			return {
+				type: 'tool_use',
+				sessionId: e.session_id,
+				toolName,
+				toolState: e.state ?? e.input,
+				raw: event,
+			};
+		}
+
+		// ---- Tool result ----
+		if (type === EV_TOOL_RESULT) {
+			// Surface as system event — tool results are context, not user-facing text
+			return {
+				type: 'system',
+				raw: event,
+			};
+		}
+
+		// ---- Final result with usage ----
+		if (type === EV_RESULT) {
+			const e = event as unknown as GrokResultEvent;
+			const text = e.result ?? e.text ?? '';
+			const usageBlock = e.usage ?? {};
+
+			const inputTokens = usageBlock.input_tokens ?? e.input_tokens ?? 0;
+			const outputTokens = usageBlock.output_tokens ?? e.output_tokens ?? 0;
+			const reasoningTokens = usageBlock.reasoning_tokens ?? e.reasoning_tokens;
+			const costUsd = usageBlock.cost_usd ?? usageBlock.total_cost ?? e.cost_usd ?? e.total_cost;
+
+			return {
+				type: 'result',
+				sessionId: e.session_id,
+				text,
+				usage: {
+					inputTokens,
+					outputTokens,
+					reasoningTokens,
+					costUsd,
+				},
+				raw: event,
+			};
+		}
+
+		// ---- Standalone usage event ----
+		if (type === EV_USAGE) {
+			const e = event as { usage?: GrokUsage } & GrokUsage;
+			const u = e.usage ?? e;
+			return {
+				type: 'usage',
+				usage: {
+					inputTokens: u.input_tokens ?? 0,
+					outputTokens: u.output_tokens ?? 0,
+					reasoningTokens: u.reasoning_tokens,
+					costUsd: u.cost_usd ?? u.total_cost,
+				},
+				raw: event,
+			};
+		}
+
+		// ---- Unknown event type — surface as system ----
+		// This ensures unknown events are visible in debug but don't pollute the UI.
+		return {
+			type: 'system',
+			raw: event,
+		};
+	}
+
+	isResultMessage(event: ParsedEvent): boolean {
+		return event.type === 'result';
+	}
+
+	extractSessionId(event: ParsedEvent): string | null {
+		return event.sessionId ?? null;
+	}
+
+	detectErrorFromLine(line: string): AgentError | null {
+		if (!line.trim()) return null;
+		const patterns = getErrorPatterns('grok-build');
+		if (!patterns) return null;
+		const match = matchErrorPattern(patterns, line);
+		if (!match) return null;
+		return {
+			...match,
+			agentId: 'grok-build',
+			timestamp: Date.now(),
+			raw: { errorLine: line },
+		};
+	}
+
+	detectErrorFromParsed(parsed: unknown): AgentError | null {
+		if (!parsed || typeof parsed !== 'object') return null;
+		// Extract the most informative text from the parsed object for pattern matching
+		const obj = parsed as Record<string, unknown>;
+		const errorText =
+			(typeof obj.message === 'string' ? obj.message : null) ??
+			(typeof obj.error === 'string' ? obj.error : null) ??
+			(typeof obj.text === 'string' ? obj.text : null) ??
+			JSON.stringify(parsed);
+		return this.detectErrorFromLine(errorText);
+	}
+}
