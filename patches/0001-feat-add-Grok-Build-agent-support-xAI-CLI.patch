+/**
+ * Unit tests for GrokBuildOutputParser
+ *
+ * ⚠️  SCHEMA NOTE: Event type constants in the parser (EV_INIT, EV_TEXT_DELTA, etc.)
+ * are best-effort guesses pending a real `grok -p "..." --output-format streaming-json` run.
+ * If tests fail after you obtain a real sample, update the constants in
+ * `src/main/parsers/grok-build-output-parser.ts` — all tests should then pass.
+ *
+ * To get a real sample:
+ *   grok -p "say hello" --output-format streaming-json 2>&1 | head -50
+ */
+
+import { describe, it, expect, beforeEach } from 'vitest';
+import { GrokBuildOutputParser } from '../../../main/parsers/grok-build-output-parser';
+import type { ParsedEvent } from '../../../main/parsers/agent-output-parser';
+
+describe('GrokBuildOutputParser', () => {
+	let parser: GrokBuildOutputParser;
+
+	beforeEach(() => {
+		parser = new GrokBuildOutputParser();
+	});
+
+	// ---- agentId ----
+
+	it('identifies as grok-build', () => {
+		expect(parser.agentId).toBe('grok-build');
+	});
+
+	// ---- parseJsonLine: empty / invalid ----
+
+	it('returns null for empty line', () => {
+		expect(parser.parseJsonLine('')).toBeNull();
+		expect(parser.parseJsonLine('   ')).toBeNull();
+	});
+
+	it('returns raw text event for non-JSON line', () => {
+		const event = parser.parseJsonLine('Grok Build v1.0.0 starting...');
+		expect(event).not.toBeNull();
+		expect(event?.type).toBe('text');
+		expect(event?.text).toBe('Grok Build v1.0.0 starting...');
+	});
+
+	it('returns null for JSON without type field', () => {
+		const event = parser.parseJsonLine('{"session_id": "abc", "model": "grok-4.3"}');
+		expect(event).toBeNull();
+	});
+
+	// ---- Init / session_start ----
+
+	it('parses session_start (init) event and extracts session ID', () => {
+		const line = JSON.stringify({
+			type: 'session_start',
+			session_id: 'grok-sess-001',
+			model: 'grok-4.3',
+		});
+		const event = parser.parseJsonLine(line);
+		expect(event?.type).toBe('init');
+		expect(event?.sessionId).toBe('grok-sess-001');
+	});
+
+	it('handles init event without session_id gracefully', () => {
+		const line = JSON.stringify({ type: 'session_start', model: 'grok-4.3' });
+		const event = parser.parseJsonLine(line);
+		expect(event?.type).toBe('init');
+		expect(event?.sessionId).toBeUndefined();
+	});
+
+	// ---- Text delta ----
+
+	it('parses content_delta event with delta field', () => {
+		const line = JSON.stringify({
+			type: 'content_delta',
+			session_id: 'sess-1',
+			delta: 'Hello, world!',
+		});
+		const event = parser.parseJsonLine(line);
+		expect(event?.type).toBe('text');
+		expect(event?.text).toBe('Hello, world!');
+		expect(event?.sessionId).toBe('sess-1');
+		expect(event?.isPartial).toBe(true);
+	});
+
+	it('parses content_delta event with content field (fallback)', () => {
+		const line = JSON.stringify({
+			type: 'content_delta',
+			content: 'Hello via content field',
+		});
+		const event = parser.parseJsonLine(line);
+		expect(event?.type).toBe('text');
+		expect(event?.text).toBe('Hello via content field');
+	});
+
+	it('parses content_delta event with text field (fallback)', () => {
+		const line = JSON.stringify({
+			type: 'content_delta',
+			text: 'Hello via text field',
+		});
+		const event = parser.parseJsonLine(line);
+		expect(event?.type).toBe('text');
+		expect(event?.text).toBe('Hello via text field');
+	});
+
+	it('returns null for content_delta with no text content', () => {
+		const line = JSON.stringify({ type: 'content_delta', session_id: 'x' });
+		expect(parser.parseJsonLine(line)).toBeNull();
+	});
+
+	// ---- Thinking / reasoning (Grok 4 Heavy) ----
+
+	it('parses thinking_delta as partial text event', () => {
+		const line = JSON.stringify({
+			type: 'thinking_delta',
+			session_id: 'sess-1',
+			delta: 'Let me think about this...',
+		});
+		const event = parser.parseJsonLine(line);
+		expect(event?.type).toBe('text');
+		expect(event?.text).toBe('Let me think about this...');
+		expect(event?.isPartial).toBe(true);
+	});
+
+	// ---- Tool use ----
+
+	it('parses tool_use event with tool field', () => {
+		const line = JSON.stringify({
+			type: 'tool_use',
+			session_id: 'sess-1',
+			tool: 'bash',
+			id: 'call-123',
+			input: { command: 'ls -la' },
+			state: 'running',
+		});
+		const event = parser.parseJsonLine(line);
+		expect(event?.type).toBe('tool_use');
+		expect(event?.toolName).toBe('bash');
+		expect(event?.sessionId).toBe('sess-1');
+	});
+
+	it('parses tool_use event with name field (fallback)', () => {
+		const line = JSON.stringify({
+			type: 'tool_use',
+			name: 'read_file',
+			state: 'complete',
+		});
+		const event = parser.parseJsonLine(line);
+		expect(event?.type).toBe('tool_use');
+		expect(event?.toolName).toBe('read_file');
+	});
+
+	it('falls back to unknown_tool for tool_use without name', () => {
+		const line = JSON.stringify({ type: 'tool_use', state: 'running' });
+		const event = parser.parseJsonLine(line);
+		expect(event?.type).toBe('tool_use');
+		expect(event?.toolName).toBe('unknown_tool');
+	});
+
+	// ---- Tool result ----
+
+	it('parses tool_result as system event', () => {
+		const line = JSON.stringify({
+			type: 'tool_result',
+			id: 'call-123',
+			output: 'file.ts\nindex.ts',
+		});
+		const event = parser.parseJsonLine(line);
+		expect(event?.type).toBe('system');
+	});
+
+	// ---- Final result ----
+
+	it('parses turn_complete event as result with usage', () => {
+		const line = JSON.stringify({
+			type: 'turn_complete',
+			session_id: 'sess-1',
+			result: 'Done! I have completed the task.',
+			usage: {
+				input_tokens: 1500,
+				output_tokens: 300,
+				reasoning_tokens: 100,
+				cost_usd: 0.0042,
+			},
+		});
+		const event = parser.parseJsonLine(line);
+		expect(event?.type).toBe('result');
+		expect(event?.text).toBe('Done! I have completed the task.');
+		expect(event?.sessionId).toBe('sess-1');
+		expect(event?.usage?.inputTokens).toBe(1500);
+		expect(event?.usage?.outputTokens).toBe(300);
+		expect(event?.usage?.reasoningTokens).toBe(100);
+		expect(event?.usage?.costUsd).toBe(0.0042);
+	});
+
+	it('parses turn_complete with top-level token fields (no usage block)', () => {
+		const line = JSON.stringify({
+			type: 'turn_complete',
+			session_id: 'sess-1',
+			text: 'Result text',
+			input_tokens: 800,
+			output_tokens: 120,
+		});
+		const event = parser.parseJsonLine(line);
+		expect(event?.type).toBe('result');
+		expect(event?.text).toBe('Result text');
+		expect(event?.usage?.inputTokens).toBe(800);
+		expect(event?.usage?.outputTokens).toBe(120);
+	});
+
+	it('handles turn_complete with empty result text gracefully', () => {
+		const line = JSON.stringify({
+			type: 'turn_complete',
+			usage: { input_tokens: 100, output_tokens: 10 },
+		});
+		const event = parser.parseJsonLine(line);
+		expect(event?.type).toBe('result');
+		expect(event?.text).toBe('');
+	});
+
+	// ---- Standalone usage event ----
+
+	it('parses standalone usage event', () => {
+		const line = JSON.stringify({
+			type: 'usage',
+			input_tokens: 500,
+			output_tokens: 80,
+			reasoning_tokens: 30,
+		});
+		const event = parser.parseJsonLine(line);
+		expect(event?.type).toBe('usage');
+		expect(event?.usage?.inputTokens).toBe(500);
+		expect(event?.usage?.outputTokens).toBe(80);
+		expect(event?.usage?.reasoningTokens).toBe(30);
+	});
+
+	// ---- Unknown event type ----
+
+	it('returns system event for unknown event type', () => {
+		const line = JSON.stringify({ type: 'some_future_event', data: 'xyz' });
+		const event = parser.parseJsonLine(line);
+		expect(event?.type).toBe('system');
+	});
+
+	// ---- isResultMessage ----
+
+	it('identifies result events correctly', () => {
+		const resultEvent: ParsedEvent = { type: 'result', text: 'done' };
+		const textEvent: ParsedEvent = { type: 'text', text: 'partial' };
+		expect(parser.isResultMessage(resultEvent)).toBe(true);
+		expect(parser.isResultMessage(textEvent)).toBe(false);
+	});
+
+	// ---- extractSessionId ----
+
+	it('extracts session ID from parsed event', () => {
+		const event: ParsedEvent = { type: 'init', sessionId: 'sess-42' };
+		expect(parser.extractSessionId(event)).toBe('sess-42');
+	});
+
+	it('returns null when no session ID', () => {
+		const event: ParsedEvent = { type: 'text', text: 'hello' };
+		expect(parser.extractSessionId(event)).toBeNull();
+	});
+
+	// ---- Error detection ----
+
+	it('detects auth expired error', () => {
+		const error = parser.detectErrorFromLine('Error: authentication failed for user');
+		expect(error?.type).toBe('auth_expired');
+		expect(error?.recoverable).toBe(true);
+	});
+
+	it('detects invalid API key error', () => {
+		const error = parser.detectErrorFromLine('Error: invalid api key provided');
+		expect(error?.type).toBe('auth_expired');
+	});
+
+	it('detects rate limit error', () => {
+		const error = parser.detectErrorFromLine('rate limit exceeded, please wait');
+		expect(error?.type).toBe('rate_limited');
+		expect(error?.recoverable).toBe(true);
+	});
+
+	it('detects token exhaustion', () => {
+		const error = parser.detectErrorFromLine('context length exceeded for this model');
+		expect(error?.type).toBe('token_exhaustion');
+		expect(error?.recoverable).toBe(false);
+	});
+
+	it('detects network error', () => {
+		const error = parser.detectErrorFromLine('ECONNREFUSED connecting to x.ai');
+		expect(error?.type).toBe('network_error');
+	});
+
+	it('detects sandbox permission denied', () => {
+		const error = parser.detectErrorFromLine('sandbox blocked network access');
+		expect(error?.type).toBe('permission_denied');
+	});
+
+	it('returns null for benign output', () => {
+		expect(parser.detectErrorFromLine('Successfully read 3 files.')).toBeNull();
+		expect(parser.detectErrorFromLine('Writing output...')).toBeNull();
+	});
+
+	// ---- raw field preservation ----
+
+	it('preserves raw field for debugging', () => {
+		const raw = { type: 'content_delta', delta: 'hi', session_id: 'x' };
+		const line = JSON.stringify(raw);
+		const event = parser.parseJsonLine(line);
+		expect(event?.raw).toEqual(raw);
+	});
+});
